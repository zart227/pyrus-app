# Секретный ключ для JWT токенов (обязательно!)
# Сгенерируйте случайный ключ: openssl rand -hex 32
SECRET_KEY=

# Время жизни access-токена в минутах (по умолчанию 8 часов)
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Время жизни refresh-токена в днях (по умолчанию 7 дней)
REFRESH_TOKEN_EXPIRE_DAYS=7

# Опционально: для автоматического создания первого пользователя при запуске
# Если не заполнено - используйте регистрацию через веб-интерфейс
PYRUS_LOGIN=
PYRUS_SECURITY_KEY=